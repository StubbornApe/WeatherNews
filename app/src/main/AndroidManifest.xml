<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      ═══════════════════════════════════════════════════════════════
      网络权限
      ═══════════════════════════════════════════════════════════════
      · android.permission.INTERNET      发起网络请求(必须)
      · android.permission.ACCESS_NETWORK_STATE  查询联网状态(用于判断"是否有网"提示)
      两者都属"普通权限",安装时授予,无需运行时申请。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:name=".WeatherNewsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeatherNewsApp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".NewsDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_news_detail"
            android:parentActivityName=".MainActivity"/>
    </application>

</manifest>